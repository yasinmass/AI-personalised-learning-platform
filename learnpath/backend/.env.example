"""
.env Configuration Guide for LearnPath

This file explains all configuration variables needed for the project.
Copy this file to .env and update the values for your environment.

SECURITY WARNING: Never commit .env file to version control!
"""

# ============================================================================
# DJANGO SETTINGS
# ============================================================================

# Secret key for Django (generate a new one for production)
SECRET_KEY=django-insecure-test-key-change-in-production

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated for production)
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database engine
DB_ENGINE=django.db.backends.postgresql

# Database name
DB_NAME=learnpath_db

# Database user
DB_USER=postgres

# Database password
DB_PASSWORD=your-secure-password

# Database host
DB_HOST=localhost

# Database port
DB_PORT=5432

# ============================================================================
# OPENAI API CONFIGURATION
# ============================================================================

# Your OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-actual-openai-api-key-here

# OpenAI model to use
OPENAI_MODEL=gpt-4

# ============================================================================
# JWT TOKEN CONFIGURATION
# ============================================================================

# Secret key for JWT token signing
JWT_SECRET=your-jwt-secret-key-for-token-signing
